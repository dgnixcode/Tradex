# Copy to .env (gitignored) and fill in. Never commit .env.

# Local PostgreSQL 18. Create the role and database with the command in the
# README, then put the password you chose here.
DATABASE_URL=postgres://tradex:CHANGE_ME@127.0.0.1:5432/tradex_dev

# 32 bytes of hex for the LocalKms root key (development only — the real thing
# is a managed KMS CMK, see 07-api-key-security.md F3).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRADEX_LOCAL_ROOT_KEY=

# Pepper for credential fingerprints (07 F4). Generate the same way.
TRADEX_FINGERPRINT_PEPPER=

# Where the API sends its credential probe when you connect an exchange account.
# Unset, this is the real https://api.coindcx.com — which needs a real, funded
# account, because onboarding refuses an account holding no spendable INR or USDT
# and CoinDCX has no sandbox to test against.
#
# For offline testing, run `npm run sandbox-venue` in another terminal and paste
# the address it prints. It serves the CoinDCX wire format and verifies
# signatures, so the connect flow behaves exactly as it does in production.
# TRADEX_VENUE_BASE=http://127.0.0.1:8099

# --- sending (off by default, and off means OFF) ------------------------------
# Without this, no venue ports are wired at all: the execution engine is never
# built and a confirm takes the rung-0 dry-run branch — it records the plan and
# sends nothing. There is no mode the code guesses at.
# TRADEX_SEND_MODE=send

# REQUIRED whenever TRADEX_SEND_MODE=send. It derives every client order id, and
# `clientOrderIdOf` is "reproducible from the row alone" — that reproducibility is
# the only thing letting a crashed worker recognise an order it already sent. A
# pepper that changed between restarts would derive a different id for a leg
# already at the venue, and the venue would accept a SECOND order. Generate once
# and never change it for a given database:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TRADEX_EXECUTION_PEPPER=

# Where a signer process listens, if you run one. Required before sending to the
# REAL exchange: invariant X12 says no plaintext credential exists outside the
# signer, so the API refuses to boot in that combination without it. Against the
# sandbox the signer runs in-process, because the sandbox holds only keys we
# invented. See docs/ops/go-live-gates.md.
# TRADEX_SIGNER_URL=http://127.0.0.1:8098

# --- email & password reset (Resend) ------------------------------------------
# Resend API key for automated password reset and transactional emails.
# RESEND_API_KEY=re_...
# RESEND_FROM=Aza WealthKare <onboarding@resend.dev>
# Base URL for reset password links in outgoing emails:
# APP_URL=https://azawealthkare.com

