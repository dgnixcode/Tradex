# Copy to .env (gitignored) and fill in. Never commit .env.

# Local PostgreSQL 18. Create the role and database with the command in the
# README, then put the password you chose here.
DATABASE_URL=postgres://tradex:CHANGE_ME@127.0.0.1:5432/tradex_dev

# 32 bytes of hex for the LocalKms root key (development only — the real thing
# is a managed KMS CMK, see 07-api-key-security.md F3).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRADEX_LOCAL_ROOT_KEY=

# Pepper for credential fingerprints (07 F4). Generate the same way.
TRADEX_FINGERPRINT_PEPPER=
